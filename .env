html, body {
  margin: 0;
  padding: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f7fb;
  color: #1d2433;
}

a { color: inherit; text-decoration: none; }
* { box-sizing: border-box; }
button, input, select { font: inherit; }

.shell { display: flex; min-height: 100vh; }
.sidebar { width: 240px; background: #0f172a; color: white; padding: 24px 18px; }
.brand { display: flex; align-items: center; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; }
.logo { width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: linear-gradient(135deg, #f59e0b, #ef4444); font-weight: 700; }
.brand strong, .brand small { display: block; }
.brand small { color: #94a3b8; }
.nav { display: flex; flex-direction: column; gap: 8px; }
.nav-link { padding: 11px 12px; border-radius: 10px; color: #dbeafe; transition: background 0.2s ease; }
.nav-link:hover { background: rgba(148, 163, 184, 0.12); }
.content { flex: 1; padding: 32px; }
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
.eyebrow { margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; font-size: 11px; font-weight: 700; }
h1, h2, p { margin: 0; }
h1 { font-size: 2rem; }
.primary-button { display: inline-flex; align-items: center; justify-content: center; border: none; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; border-radius: 10px; padding: 11px 16px; font-weight: 600; cursor: pointer; }
.grid { display: grid; gap: 18px; }
.metrics-grid { grid-template-columns: repeat(4, minmax(180px, 1fr)); margin-bottom: 22px; }
.two-column-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 20px; margin-bottom: 22px; }
.card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px 20px; box-shadow: 0 10px 24px rgba(15,23,42,0.03); }
.metric-card { display: flex; flex-direction: column; gap: 8px; }
.metric-card span { color: #64748b; font-size: 0.86rem; }
.metric-card strong { font-size: 1.6rem; }
.metric-card small { color: #475569; }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.tag { display: inline-flex; padding: 6px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; }
.tag.warning { background: #fff7ed; color: #c2410c; }
.tag.success { background: #ecfdf5; color: #047857; }
.tag.neutral { background: #f1f5f9; color: #475569; }
.stack-list { display: flex; flex-direction: column; gap: 12px; }
.list-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #edf2f7; }
.list-row:last-child { border-bottom: none; }
.warn-row { background: #fff8f1; border-radius: 10px; padding: 12px 14px; border: 1px solid #fed7aa; }
.right-align { text-align: right; }
.list-row strong, .list-row small, .list-row span { display: block; }
.list-row small, .right-align small { color: #64748b; }
.table { width: 100%; border-collapse: collapse; }
.table th, .table td { padding: 12px 10px; text-align: left; border-bottom: 1px solid #edf2f7; }
.table th { color: #475569; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; }
.status { display: inline-flex; padding: 5px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
.status-paid, .status-active { background: #ecfdf5; color: #047857; }
.status-pending { background: #fff7ed; color: #c2410c; }
.status-inactive { background: #f1f5f9; color: #475569; }
.form-card { margin-bottom: 22px; }
.two-col-form { grid-template-columns: repeat(2, minmax(180px, 1fr)); }
label { display: flex; flex-direction: column; gap: 8px; color: #334155; font-weight: 600; }
input, select { width: 100%; border: 1px solid #dbe1ea; padding: 10px 12px; border-radius: 10px; background: #fff; }
.margin-top { margin-top: 18px; }
.pos-layout { align-items: start; }
.product-list { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
.product-item { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 12px 14px; border-radius: 12px; border: 1px solid #e2e8f0; background: #f8fafc; cursor: pointer; text-align: left; }
.product-item strong, .product-item small { display: block; }
.product-item small { color: #64748b; }
.receipt-items { display: flex; flex-direction: column; gap: 12px; margin: 18px 0 12px; }
.receipt-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #edf2f7; }
.receipt-row strong, .receipt-row small { display: block; }
.receipt-row small { color: #64748b; }
.receipt-controls { display: flex; align-items: center; gap: 8px; }
.receipt-controls button { width: 26px; height: 26px; border: 1px solid #dbe1ea; border-radius: 8px; background: white; cursor: pointer; }
.vat-toggle { margin-top: 16px; margin-bottom: 16px; }
.vat-toggle label { display: flex; align-items: center; flex-direction: row; gap: 10px; }
.vat-toggle input { width: auto; }
.totals-box { display: flex; flex-direction: column; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; margin-bottom: 16px; }
.totals-box div { display: flex; justify-content: space-between; align-items: center; }
.grand-total { font-size: 1.1rem; padding-top: 8px; border-top: 1px solid #dbe1ea; }
.full-width { width: 100%; }
.danger-text { color: #dc2626; font-weight: 700; }

@media (max-width: 980px) {
  .shell { flex-direction: column; }
  .sidebar { width: 100%; }
  .metrics-grid, .two-column-grid, .two-col-form { grid-template-columns: 1fr; }
}
